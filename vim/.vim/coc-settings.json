{
  "suggest.noselect": false,
  "suggest.enablePreview": true,
  "suggest.timeout": 200,
  "suggest.minTriggerInputLength": 1,
  "coc.preferences.formatOnSave": true,
  "coc.preferences.formatOnType": false,
  "diagnostic.enable": true,
  "diagnostic.virtualText": true,
  "diagnostic.checkCurrentLine": true,
  "diagnostic.messageTarget": "echo",
  "signature.enable": true,
  "yaml.validate": true,
  "yaml.format.enable": true,
  "yaml.hover": true,
  "yaml.completion": true,
  "yaml.schemaStore.enable": true,
  "yaml.schemaStore.url": "https://www.schemastore.org/api/json/catalog.json",
  "yaml.schemas": {
    "kubernetes": [
      "**/*k8s*.yml",
      "**/*k8s*.yaml",
      "**/k8s/**/*.yml",
      "**/k8s/**/*.yaml",
      "**/manifests/**/*.yml",
      "**/manifests/**/*.yaml",
      "**/kubernetes/**/*.yml",
      "**/kubernetes/**/*.yaml",
      "**/*deployment*.yml",
      "**/*deployment*.yaml",
      "**/*service*.yml",
      "**/*service*.yaml",
      "**/*ingress*.yml",
      "**/*ingress*.yaml",
      "**/*configmap*.yml",
      "**/*configmap*.yaml",
      "**/*secret*.yml",
      "**/*secret*.yaml",
      "**/*kustomization*.yml",
      "**/*kustomization*.yaml",
      "**/*helm*values*.yml",
      "**/*helm*values*.yaml"
    ]
  },
  "ansible.validation.enabled": true,
  "ansible.validation.lint.enabled": true,
  "ansible.python.interpreterPath": "python3",
  "ansible.ansible.path": "ansible",
  "ansible.ansibleLint.path": "ansible-lint",
  "ansible.playbookGlobs": [
    "**/playbooks/**/*.{yml,yaml}",
    "**/*playbook*.{yml,yaml}"
  ],
  "terraform.format.enable": true,
  "terraform.validate.enable": true,
  "terraform.languageServer.enable": true,
  "terraform.languageServer.path": "terraform-ls",
  "terraform.languageServer.args": [
    "serve"
  ],
  "python.pythonPath": "python3",
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.diagnosticMode": "workspace",
  "python.analysis.useLibraryCodeForTypes": true,
  "python.formatting.provider": "black",
  "python.formatting.blackPath": "black",
  "clangd.enabled": true,
  "clangd.arguments": [
    "--background-index",
    "--clang-tidy",
    "--completion-style=detailed",
    "--header-insertion=iwyu",
    "--pch-storage=memory"
  ],
  "inlayHint.enable": false,
  "clangd.inlayHints.enable": false,
  "markdownlint.config": {
    "MD013": false,
    "MD004": false
  }
}
